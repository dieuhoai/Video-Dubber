{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(python scripts/check_privacy.py:*)",
      "Bash(python scripts/setup_env.py:*)",
      "Bash(python scripts/build_exe.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
